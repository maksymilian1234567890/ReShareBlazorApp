@page "/profil"
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>Mój Profil - ReShare</PageTitle>

<div class="container" style="padding: 2rem 1rem;">
    <div style="max-width: 600px; margin: 0 auto; background: white; border: 1px solid #e2e8f0; border-radius: 16px; padding: 2rem;">
        <h2>Twój Profil</h2>
        <p style="color: #64748b; margin-bottom: 2rem;">Zarządzaj swoim kontem i ogłoszeniami.</p>

        <AuthorizeView>
            <Authorized Context="auth">
                <div style="background: #f8fafc; padding: 1.5rem; border-radius: 10px; margin-bottom: 1.5rem;">
                    <p style="margin: 0; font-weight: 600; color: #1e293b;">Zalogowany adres e-mail:</p>
                    <p style="margin: 0.5rem 0 0 0; color: #2563eb;">@auth.User.FindFirst(ClaimTypes.Email)?.Value</p>
                </div>
            </Authorized>
            <NotAuthorized>
                <div style="background: #fef2f2; border: 1px solid #fecaca; padding: 1rem; border-radius: 8px; color: #991b1b; margin-bottom: 1.5rem;">
                    Nie jesteś zalogowany. <a href="login" style="color: #2563eb; font-weight: 600;">Zaloguj się tutaj</a>.
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>